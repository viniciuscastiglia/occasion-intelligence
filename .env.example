# Configuração do briefing por LLM (provedor compatível com a API da OpenAI).
# Escolhido pelo autor: Groq com o modelo qwen/qwen3.8-27b. A comparação com os outros
# candidatos (latência, aprovação na conferência, falhas) está em reports/briefing_provedores.json.
#
# Nada na aplicação lê este arquivo. Exporte as três variáveis no shell antes de abrir a tela
# (por exemplo, `set -a; . ./.env; set +a`) ou ponha as mesmas três chaves em
# `.streamlit/secrets.toml` (no .gitignore). Nunca commite a chave.
# Sem as três, a tela mostra o texto reserva com o motivo "sem chave configurada".
BRIEFING_BASE_URL=https://api.groq.com/openai/v1
BRIEFING_MODELO=qwen/qwen3.8-27b
BRIEFING_CHAVE=
